# токен бота
TELEGRAM_BOT_TOKEN=
# если api.telegram.org недоступен из вашей сети, укажите прокси (http://host:port или socks5://host:port)
TELEGRAM_PROXY=

# используется любой OpenAI-совместимый API
# вариант A: Ollama установлена на вашем компьютере, бот работает в Docker
LLM_BASE_URL=http://127.0.0.1:11434/v1
# вариант B: Ollama в контейнере (docker compose --profile local-llm up)
# LLM_BASE_URL=http://ollama:11434/v1
# вариант C: внешний провайдер
# LLM_BASE_URL=https://api.provider.com/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
# Сколько секунд ждать ответ модели
LLM_TIMEOUT=180

# эмбеддинги (без них поиск работает по словам, BM25)
# чтобы включить: ollama pull bge-m3, заполнить три строки ниже,
# выполнить python -m app.kb.embed (или в Docker: docker compose run --rm bot python -m app.kb.embed)
# и перезапустить бота
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=ollama

# пороги релевантности поиска
MIN_COVERAGE=0.6
MIN_DENSE=0.55
# однословный запрос, слово которого есть в таком проценте фрагментов (здесь - 8%), считается слишком общим: бот уточнит
VAGUE_DF=0.08

# аналитика (идентификатор чата в событиях хранится только в виде хеша с этой солью)
ANALYTICS_SALT=замените-на-свою-строку

# данные
DATA_DIR=/data
DUMP_FILE=alfa_course_hackathon.backup

# домен платформы и шаблоны путей. Пока домен не задан, бот показывает источники без ссылок.
PLATFORM_BASE_URL=
LINK_TPL_ARTICLE={base}/articles/{url}
LINK_TPL_COURSE={base}/courses/{url}
LINK_TPL_WEBINAR={base}/webinars/{url}
LINK_TPL_PODCAST={base}/podcasts/{url}
LINK_TPL_DOCUMENT={base}/documents/{url}
LINK_TPL_CALCULATOR={base}/calculators/{url}
LINK_TPL_GLOSSARY={base}/glossary/{url}
